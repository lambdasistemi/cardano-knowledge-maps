@prefix : <https://example.org/smoke/sameas-key#> .
@prefix cardano: <https://lambdasistemi.github.io/cardano-knowledge-maps/vocab/cardano#> .

# Two distinct blank-node Identifier instances with matching role-class
# and matching hex bytes. Under the `cardano:Identifier owl:hasKey
# (cardano:leafType cardano:bytesHex)` axiom (declared in transactions.ttl),
# EYE deduces `:id1 owl:sameAs :id2` through its bundled OWL 2 RL
# `owl-hasKey.n3` rule fragment.

:id1 a cardano:Identifier ;
  cardano:leafType cardano:PaymentScript ;
  cardano:bytesHex "32201dc1e82708364c6c42a53f89f675314bb9ad5da2734aa10baa0d" .

:id2 a cardano:Identifier ;
  cardano:leafType cardano:PaymentScript ;
  cardano:bytesHex "32201dc1e82708364c6c42a53f89f675314bb9ad5da2734aa10baa0d" .
