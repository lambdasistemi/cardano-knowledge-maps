PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX :     <https://example.org/smoke/baseline#>

# EXPECT: true
# Transitive subClassOf reaches :C through the chain :A ⊑ :B ⊑ :C.
ASK { :thing rdf:type :C }

# EXPECT: false
# Anti-check: a class outside the chain must not be inferred.
ASK { :thing rdf:type :Z }
